# Supabase edge functions and migrations (server-side only)
supabase/

# Environment files (CRITICAL - never deploy these)
.env
.env.*
!.env.example

# Development artifacts
node_modules/
package-lock.json
yarn.lock

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# Git
.git/
.gitignore

# Logs and temp files
*.log
tmp/
temp/
*.tmp

# Documentation — internal, never served
*.md

# SQL and tests (server-side / local only).
# `scripts/` is deliberately NOT here: buildCommand is `node scripts/build.js`,
# so excluding it would break the build.
sql/
tests/

# Supabase CLI binary, if it is sitting in the project root
supabase.exe
*.tar.gz
