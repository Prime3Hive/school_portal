# TBD International Academy — https://tbdacademy.org
#
# Copy to `.env` for local development. Production values live in the Vercel
# dashboard and in Supabase secrets, never in this repo.
#
# SECURITY: `.env` is fetched over HTTP by js/env-loader.js when you develop
# against localhost, which means the browser can read every line of it. Only
# public values belong here. Secrets — the Paystack secret key, the Supabase
# service role key, the Resend API key — go in Supabase/Vercel, never in `.env`.

# --- Supabase (public: anon key is RLS-protected) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# --- Paystack (public key only; pk_test_* locally, pk_live_* in production) ---
PAYSTACK_PUBLIC_KEY=pk_test_your_test_key_here

# --- App ---
APP_ENV=development
APP_URL=http://localhost:8000
SESSION_TIMEOUT_MINUTES=30

# --- School information ---
SCHOOL_NAME=TBD International Academy
SCHOOL_EMAIL=support@tbdacademy.org
SCHOOL_PHONE=0803 061 4777
SCHOOL_ADDRESS=Behind Civil Service Commission, Kertyo, Makurdi, Benue State

# --- Mailboxes shown in the UI (sending happens in the edge functions) ---
EMAIL_FROM_ADDRESS=support@tbdacademy.org
EMAIL_FROM_NAME=TBD International Academy
SUPPORT_EMAIL=support@tbdacademy.org
FINANCE_EMAIL=finance@tbdacademy.org
ADMISSIONS_EMAIL=headteacher@tbdacademy.org

# --- Bank transfer details (shown on the admissions page) ---
SCHOOL_BANK_NAME=
SCHOOL_BANK_ACCOUNT=
SCHOOL_BANK_ACCOUNT_NAME=
SCHOOL_BANK_BRANCH=
