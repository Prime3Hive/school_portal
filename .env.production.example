# Production configuration — TBD International Academy (https://tbdacademy.org)
#
# Nothing here is read from a file in production. The values live in two places,
# and which place decides whether the browser can see them:
#
#   VERCEL  → Project Settings → Environment Variables
#             Served to the browser by /api/config. PUBLIC BY DEFINITION.
#
#   SUPABASE → `supabase secrets set KEY=value`
#             Readable only inside edge functions. This is where secrets live.
#
# Putting a secret in the Vercel group publishes it. Check the group before you
# paste anything that starts with sk_, eyJ… (service role), or re_.


# ════════════════════════════════════════════════════════════════════════
# VERCEL — public, served to every visitor via /api/config
# ════════════════════════════════════════════════════════════════════════

# https://app.supabase.com/project/YOUR_PROJECT/settings/api
# The anon key is safe to publish: RLS is what protects the data behind it.
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxx

# https://dashboard.paystack.com/#/settings/developers — PUBLIC key only.
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxx

APP_ENV=production
APP_URL=https://tbdacademy.org
SESSION_TIMEOUT_MINUTES=30

SCHOOL_NAME=TBD International Academy
SCHOOL_EMAIL=support@tbdacademy.org
SCHOOL_PHONE=0803 061 4777
SCHOOL_ADDRESS=Behind Civil Service Commission, Kertyo, Makurdi, Benue State

EMAIL_FROM_ADDRESS=support@tbdacademy.org
EMAIL_FROM_NAME=TBD International Academy
SUPPORT_EMAIL=support@tbdacademy.org
FINANCE_EMAIL=finance@tbdacademy.org
ADMISSIONS_EMAIL=headteacher@tbdacademy.org

# Shown to applicants paying by bank transfer.
SCHOOL_BANK_NAME=
SCHOOL_BANK_ACCOUNT=
SCHOOL_BANK_ACCOUNT_NAME=
SCHOOL_BANK_BRANCH=


# ════════════════════════════════════════════════════════════════════════
# SUPABASE SECRETS — never reach the browser
# ════════════════════════════════════════════════════════════════════════
#
#   supabase secrets set \
#     PAYSTACK_SECRET_KEY=sk_live_xxx \
#     RESEND_API_KEY=re_xxx \
#     MAIL_DOMAIN=tbdacademy.org \
#     APP_URL=https://tbdacademy.org \
#     SCHOOL_NAME="TBD International Academy"
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# into edge functions automatically — do not set them by hand.

# Paystack SECRET key. Verifies charges server-side and signs webhooks.
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxx

# Resend API key. https://resend.com/api-keys
# The tbdacademy.org domain must be verified in Resend first, or every send
# is rejected with a 403.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# Domain the three mailboxes hang off. Changing this changes every from-address.
MAIL_DOMAIN=tbdacademy.org

# Absolute base for links inside emails. Must be the live domain: an invitation
# link is clicked hours after it is sent, long after any request context is gone.
APP_URL=https://tbdacademy.org

SCHOOL_NAME=TBD International Academy
